    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "disk-cleaner"
            VALUE "FileDescription", "disk-cleaner"
            VALUE "FileVersion", "0.10.0"
            VALUE "InternalName", "disk-cleaner"
            VALUE "OriginalFilename", "disk-cleaner.exe"
            VALUE "ProductName", "disk-cleaner"
            VALUE "ProductVersion", "0.10.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
